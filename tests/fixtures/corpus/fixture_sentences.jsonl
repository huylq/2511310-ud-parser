{"char_end": 38, "char_start": 0, "content_hash": "8b1160eafd8bee00eb5d94338f76f2593aa9480e979a2600d16638ccd6723c79", "idx": 0, "register": "informal", "sent_id": "8b1160eafd8bee00eb5d94338f76f2593aa9480e979a2600d16638ccd6723c79:0", "text": "Tao vừa ăn phở xong, ngon dã man luôn."}
{"char_end": 36, "char_start": 0, "content_hash": "c7680c1bf5a23ef01e3eb25e08341e0d35c767f31e9661b4140929e51ce6f078", "idx": 0, "register": "informal", "sent_id": "c7680c1bf5a23ef01e3eb25e08341e0d35c767f31e9661b4140929e51ce6f078:0", "text": "Mai đi học sớm nha, đừng trễ nữa đó."}
{"char_end": 42, "char_start": 0, "content_hash": "01943fa9c5fd93f5099bf0102ba6d25eb064f433ee44f8afcded7dfda20568ff", "idx": 0, "register": "informal", "sent_id": "01943fa9c5fd93f5099bf0102ba6d25eb064f433ee44f8afcded7dfda20568ff:0", "text": "Bộ phim tối qua coi hay ghê, mày xem chưa?"}
{"char_end": 44, "char_start": 0, "content_hash": "faeb5546b7943116a8a9dfcb1fa8310f03abc87740bd4b41f6c5b8dfcb0fbddd", "idx": 0, "register": "informal", "sent_id": "faeb5546b7943116a8a9dfcb1fa8310f03abc87740bd4b41f6c5b8dfcb0fbddd:0", "text": "Cuối tuần này rảnh không, đi chơi Đà Lạt đi."}
{"char_end": 40, "char_start": 0, "content_hash": "19d0dfb914afd53f52627dec599590b38aacabfb15800776a440677a76e06066", "idx": 0, "register": "informal", "sent_id": "19d0dfb914afd53f52627dec599590b38aacabfb15800776a440677a76e06066:0", "text": "Nay mưa to quá trời, chắc kẹt xe dữ lắm."}
