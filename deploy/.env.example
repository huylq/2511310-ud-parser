# Copy to deploy/.env on the server and fill in. NEVER commit the filled copy.
# Ports bind to 127.0.0.1 only; reach them over an SSH tunnel, not the open net.

# --- secrets ---
DEEPSEEK_API_KEY=
HF_TOKEN=
POSTGRES_PASSWORD=
MINIO_ROOT_USER=vietnlp
MINIO_ROOT_PASSWORD=
FUSEKI_ADMIN_PASSWORD=

# P1a: z.ai MCP tools (web-search-prime, web-reader) — see
# src/vietnlp/acquisition/mcp_client.py
ZAI_API_KEY=

# P1a: salts author-identifier hashing so it can't be dictionary-reversed
# against a list of known usernames — see src/vietnlp/acquisition/anonymize.py
VIETNLP_AUTHOR_HASH_SALT=

# --- budget caps (USD). Rule 5: these abort a flow, they do not warn. ---
VIETNLP_FLOW_CAP_USD=5
VIETNLP_DAILY_CAP_USD=20
VIETNLP_TOTAL_CAP_USD=200

# --- DeepSeek pricing per 1M tokens. Verify against the live pricing page. ---
# https://api-docs.deepseek.com/quick_start/pricing
DEEPSEEK_PRICE_CHAT_IN_MISS=0.27
DEEPSEEK_PRICE_CHAT_IN_HIT=0.07
DEEPSEEK_PRICE_CHAT_OUT=1.10
DEEPSEEK_PRICE_REASONER_IN_MISS=0.55
DEEPSEEK_PRICE_REASONER_IN_HIT=0.14
DEEPSEEK_PRICE_REASONER_OUT=2.19

# --- ports on _59 (6040-6049 block was free at deploy time) ---
PG_PORT=6042
MINIO_PORT=6043
MINIO_CONSOLE_PORT=6044
FUSEKI_PORT=6045
